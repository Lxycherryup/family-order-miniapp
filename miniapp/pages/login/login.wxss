.login-page {
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-card {
  width: 100%;
  padding: 56rpx 40rpx;
  text-align: center;
}

.brand-mark {
  display: inline-flex;
  width: 96rpx;
  height: 96rpx;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  color: #ffffff;
  background: #2c6e49;
  font-size: 44rpx;
  font-weight: 700;
}

.title {
  margin-top: 28rpx;
  font-size: 42rpx;
  font-weight: 700;
}

.subtitle {
  margin-top: 14rpx;
  color: #7b8794;
}

.login-button {
  margin-top: 48rpx;
}

.message {
  margin-top: 24rpx;
  color: #d9480f;
  line-height: 1.6;
}
