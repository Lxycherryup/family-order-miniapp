<view class="page login-page">
  <view class="login-card card">
    <view class="brand-mark">家</view>
    <view class="title">家庭点餐</view>
    <view class="subtitle">登录后即可浏览菜单并提交订单</view>
    <button class="primary-button login-button" loading="{{loading}}" bindtap="handleLogin">
      微信登录
    </button>
    <view wx:if="{{message}}" class="message">{{message}}</view>
  </view>
</view>
