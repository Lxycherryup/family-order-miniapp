.cart-page {
  padding-bottom: 132rpx;
}

.empty {
  padding: 80rpx 32rpx;
  color: #7b8794;
  text-align: center;
}

.empty button {
  margin-top: 32rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 18rpx;
  padding: 18rpx;
}

.item-image {
  display: flex;
  width: 112rpx;
  height: 112rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #edf7ef;
  color: #7b8794;
  font-size: 22rpx;
}

.item-info {
  flex: 1;
  min-width: 0;
}

.item-name {
  overflow: hidden;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-price {
  margin-top: 8rpx;
  color: #d9480f;
  font-weight: 700;
}

.quantity {
  display: flex;
  flex: none;
  align-items: center;
  gap: 12rpx;
}

.quantity button {
  width: 58rpx;
  height: 58rpx;
  padding: 0;
  line-height: 58rpx;
}

.remark {
  margin-top: 24rpx;
  padding: 24rpx;
}

.section-title {
  margin-bottom: 16rpx;
  font-weight: 700;
}

.remark textarea {
  width: 100%;
  min-height: 160rpx;
  color: #1f2933;
  font-size: 28rpx;
}

.submit-bar {
  position: fixed;
  right: 24rpx;
  bottom: 24rpx;
  left: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #1f2933;
  color: #ffffff;
  box-shadow: 0 12rpx 40rpx rgba(31, 41, 51, 0.22);
}

.summary-count {
  font-size: 24rpx;
  opacity: 0.8;
}

.summary-amount {
  margin-top: 4rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.submit-button {
  width: 200rpx;
}
