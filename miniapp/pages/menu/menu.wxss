.menu-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 132rpx;
}

.top-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
}

.menu-body {
  display: flex;
  height: calc(100vh - 188rpx);
  gap: 20rpx;
}

.category-list {
  width: 176rpx;
  flex: none;
}

.category-item {
  margin-bottom: 12rpx;
  padding: 22rpx 16rpx;
  border-radius: 12rpx;
  color: #52606d;
  background: #ffffff;
  text-align: center;
}

.category-item.active {
  color: #2c6e49;
  background: #edf7ef;
  font-weight: 700;
}

.dish-list {
  flex: 1;
  min-width: 0;
}

.dish-card {
  display: flex;
  gap: 20rpx;
  margin-bottom: 18rpx;
  padding: 18rpx;
}

.dish-image {
  display: flex;
  width: 150rpx;
  height: 150rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #edf7ef;
  color: #7b8794;
  font-size: 24rpx;
}

.dish-info {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 700;
}

.dish-desc {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 8rpx;
  color: #7b8794;
  font-size: 24rpx;
  line-height: 1.5;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.dish-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
}

.price {
  color: #d9480f;
  font-size: 32rpx;
  font-weight: 700;
}

.unit {
  color: #7b8794;
  font-size: 24rpx;
}

.add-button {
  color: #ffffff;
  background: #2c6e49;
}

.empty {
  padding: 80rpx 0;
  color: #7b8794;
  text-align: center;
}

.cart-bar {
  position: fixed;
  right: 24rpx;
  bottom: 24rpx;
  left: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #1f2933;
  color: #ffffff;
  box-shadow: 0 12rpx 40rpx rgba(31, 41, 51, 0.22);
}

.cart-count {
  font-size: 24rpx;
  opacity: 0.8;
}

.cart-amount {
  margin-top: 4rpx;
  font-size: 34rpx;
  font-weight: 700;
}

.cart-button {
  width: 180rpx;
}
