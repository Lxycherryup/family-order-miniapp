page {
  min-height: 100%;
  background: #f5f7f2;
  color: #1f2933;
  font-size: 28rpx;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

button {
  margin: 0;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
}

.primary-button {
  color: #ffffff;
  background: #2c6e49;
}

.muted-text {
  color: #7b8794;
}

.card {
  border: 1rpx solid #dfe5dc;
  border-radius: 12rpx;
  background: #ffffff;
}
